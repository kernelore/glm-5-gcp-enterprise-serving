apiVersion: v1
kind: ConfigMap
metadata:
  name: glm52-benchmark-runner
  namespace: llm-serving
  labels:
    app: glm52-benchmark
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
data:
  benchmark_runner.sh: |
    #!/bin/bash
    set -euo pipefail
    echo "=============================================================================="
    echo "GLM-5.2 Sovereign Enterprise Inference - In-Cluster Benchmark Execution"
    echo "Mode: ${BENCHMARK_MODE:-soak}"
    echo "=============================================================================="
    mkdir -p /results
    python3 -c '
    import urllib.request, json, sys, time
    print("Testing gateway cluster connectivity...")
    '
    wait_for_quiesce() {
      local timeout="${1:-300}"
      local settle_time="${2:-15}"
      local required_zero_checks=3
      local zero_count=0
      local start_time=$(date +%s)
      local metrics_url="http://glm52-serving-svc.llm-serving.svc.cluster.local:8000/metrics"

      echo ""
      echo "------------------------------------------------------------------------------"
      echo "--> Verifying engine quiesce & draining in-flight work (timeout: ${timeout}s)..."
      echo "------------------------------------------------------------------------------"
      
      while true; do
        local now=$(date +%s)
        local elapsed=$((now - start_time))
        if [ "${elapsed}" -ge "${timeout}" ]; then
          echo "ERROR: Engine failed to quiesce within ${timeout}s! In-flight requests did not drain to zero." >&2
          exit 1
        fi
        local metrics_payload
        if ! metrics_payload=$(python3 -c "import urllib.request; print(urllib.request.urlopen('${metrics_url}', timeout=5).read().decode('utf-8'))" 2>/dev/null); then
          echo "    [CHECK] Failed to reach ${metrics_url}. Resetting consecutive zero check count."
          zero_count=0
        else
          local inflight
          inflight=$(printf '%s\n' "${metrics_payload}" | awk '/^[^#].*(num_requests_waiting|num_requests_running|num_queue_reqs|num_running_reqs)/ {sum += $NF} END {printf "%.0f", sum + 0}')
          if [ -n "${inflight}" ] && [ "${inflight}" -eq 0 ] 2>/dev/null; then
            zero_count=$((zero_count + 1))
            echo "    [CHECK] In-flight requests: 0 (consecutive zero checks: ${zero_count}/${required_zero_checks})"
            if [ "${zero_count}" -ge "${required_zero_checks}" ]; then
              echo "    [OK] Engine quiesced successfully after ${elapsed}s."
              break
            fi
          else
            echo "    [CHECK] In-flight requests: ${inflight:-unknown}. Waiting for engine queue to drain..."
            zero_count=0
          fi
        fi
        sleep 5
      done
      echo "--> Quiesce confirmed. Waiting an additional ${settle_time}s settle period before next suite..."
      sleep "${settle_time}"
      echo "------------------------------------------------------------------------------"
    }

    wait_for_quiesce 300 15

    if [ "${BENCHMARK_MODE}" = "prefill" ] || [ "${BENCHMARK_MODE}" = "all" ]; then
      echo "Running in-cluster prefill ingestion benchmark (isolated baseline)..."
      python3 /scripts/run_prefill_benchmark.py \
        --endpoint="http://glm52-serving-svc.llm-serving.svc.cluster.local:8000/v1/completions" \
        --metadata="$(cat /scripts/metadata.json)" \
        --output=/results/prefill_results.json || echo "WARNING: prefill benchmark reported errors."
      wait_for_quiesce 300 15
    fi
    if [ "${BENCHMARK_MODE}" = "standard" ] || [ "${BENCHMARK_MODE}" = "all" ]; then
      echo "Running in-cluster standard benchmark..."
      python3 /scripts/benchmark_glm52.py \
        --endpoint="http://glm52-gateway-svc.llm-serving.svc.cluster.local:4000/v1/chat/completions" \
        --api-key="${GATEWAY_MASTER_KEY}" \
        --concurrency="${BENCHMARK_CONCURRENCY:-8}" \
        --requests="${BENCHMARK_REQUESTS:-16}" \
        --metadata="$(cat /scripts/metadata.json)" \
        --output=/results/standard_results.json || echo "WARNING: standard benchmark reported errors."
      wait_for_quiesce 300 15
    fi
    if [ "${BENCHMARK_MODE}" = "massive" ] || [ "${BENCHMARK_MODE}" = "all" ]; then
      echo "Running in-cluster massive benchmark..."
      python3 /scripts/massive_benchmark_glm52.py \
        --endpoint="http://glm52-gateway-svc.llm-serving.svc.cluster.local:4000/v1/chat/completions" \
        --api-key="${GATEWAY_MASTER_KEY}" \
        --concurrency="${BENCHMARK_CONCURRENCY:-20}" \
        --requests="${BENCHMARK_REQUESTS:-100}" \
        --metadata="$(cat /scripts/metadata.json)" \
        --output=/results/massive_results.json || echo "WARNING: massive benchmark reported errors."
      wait_for_quiesce 300 15
    fi
    if [ "${BENCHMARK_MODE}" = "soak" ] || [ "${BENCHMARK_MODE}" = "all" ]; then
      echo "Running in-cluster soak benchmark..."
      python3 /scripts/soak_benchmark_glm52.py \
        --endpoint="http://glm52-gateway-svc.llm-serving.svc.cluster.local:4000/v1/chat/completions" \
        --api-key="${GATEWAY_MASTER_KEY}" \
        --duration="${BENCHMARK_DURATION:-1800}" \
        --concurrency="${BENCHMARK_CONCURRENCY:-18}" \
        --metadata="$(cat /scripts/metadata.json)" \
        --output=/results/soak_results.json || echo "WARNING: soak benchmark reported errors."
      wait_for_quiesce 300 15
    fi
    if [ "${BENCHMARK_MODE}" = "saturation" ] || [ "${BENCHMARK_MODE}" = "all" ]; then
      echo "Running in-cluster saturation sweep benchmark..."
      python3 /scripts/run_saturation_sweep.py \
        --endpoint="http://glm52-serving-svc.llm-serving.svc.cluster.local:8000/v1/completions" \
        --metadata="$(cat /scripts/metadata.json)" \
        --output=/results/saturation_results.json || echo "WARNING: saturation benchmark reported errors."
      wait_for_quiesce 300 15
    fi
    echo "In-cluster benchmark execution completed. Results in /results:"
    ls -lh /results/
    touch /results/.done
    echo "Waiting up to 300s for results extraction..."
    for _ in {1..150}; do
      if [ -f /results/.extracted ]; then
        echo "Results extracted successfully. Exiting."
        break
      fi
      sleep 2
    done
---
apiVersion: batch/v1
kind: Job
metadata:
  name: glm52-incluster-benchmark
  namespace: llm-serving
  labels:
    app: glm52-benchmark
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app: glm52-benchmark
        env: ${ENV_LABEL}
    spec:
      restartPolicy: Never
      tolerations:
      - key: "cloud.google.com/gke-spot"
        operator: "Equal"
        value: "true"
        effect: "NoSchedule"
      - key: "cloud.google.com/gke-spot"
        operator: "Exists"
        effect: "NoSchedule"
      nodeSelector:
        cloud.google.com/gke-nodepool: "np-system-spot"
        cloud.google.com/gke-spot: "true"
      containers:
      - name: benchmark-runner
        image: python:3.11-slim
        imagePullPolicy: IfNotPresent
        command: ["/bin/bash", "/runner/benchmark_runner.sh"]
        env:
        - name: GATEWAY_MASTER_KEY
          valueFrom:
            secretKeyRef:
              name: glm52-gateway-secrets
              key: GATEWAY_MASTER_KEY
        - name: BENCHMARK_MODE
          value: "${BENCHMARK_MODE}"
        - name: BENCHMARK_CONCURRENCY
          value: "${BENCHMARK_CONCURRENCY}"
        - name: BENCHMARK_REQUESTS
          value: "${BENCHMARK_REQUESTS}"
        - name: BENCHMARK_DURATION
          value: "${BENCHMARK_DURATION}"
        resources:
          requests:
            cpu: "2"
            memory: "4Gi"
          limits:
            cpu: "4"
            memory: "8Gi"
        volumeMounts:
        - name: runner-vol
          mountPath: /runner
        - name: script-vol
          mountPath: /scripts
        - name: results-vol
          mountPath: /results
      volumes:
      - name: runner-vol
        configMap:
          name: glm52-benchmark-runner
          defaultMode: 0755
      - name: script-vol
        configMap:
          name: glm52-benchmark-scripts
          defaultMode: 0755
      - name: results-vol
        emptyDir: {}
