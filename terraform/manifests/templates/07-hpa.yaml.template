apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: glm52-serving-hpa
  namespace: llm-serving
  labels:
    app: glm52-serving
    env: ${ENV_LABEL}
    owner: ${OWNER_LABEL}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: glm52-nvfp4-serving
  minReplicas: 1
  maxReplicas: ${GPU_MAX_NODES}
  metrics:
  - type: External
    external:
      metric:
        name: prometheus.googleapis.com|${HPA_QUEUE_METRIC}
        selector:
          matchLabels:
            metric.labels.top_level_controller_name: glm52-nvfp4-serving
      target:
        type: AverageValue
        averageValue: "16"
  - type: External
    external:
      metric:
        name: prometheus.googleapis.com|${HPA_RUNNING_METRIC}
        selector:
          matchLabels:
            metric.labels.top_level_controller_name: glm52-nvfp4-serving
      target:
        type: AverageValue
        averageValue: "20"

