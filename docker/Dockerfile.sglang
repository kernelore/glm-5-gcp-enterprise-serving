FROM lmsysorg/sglang:v0.5.16-cu130

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "huggingface_hub[hf_transfer]>=0.26.0" \
    && python3 -c "import transformers.configuration_utils as m; f = m.__file__; txt = open(f).read(); txt = txt.replace('ALLOWED_LAYER_TYPES = (', 'ALLOWED_LAYER_TYPES = (\n    \"deepseek_sparse_attention\",'); open(f, 'w').write(txt); assert 'deepseek_sparse_attention' in open(f).read(), 'ALLOWED_LAYER_TYPES patch failed'" \
    && python3 -c "import inspect, importlib; from transformers.models.auto.configuration_auto import CONFIG_MAPPING; matched = [k for k, v in CONFIG_MAPPING.items() if 'glm' in k or 'dsa' in k]; print(f'GLM/DSA config keys inspected: {matched}'); assert matched, 'no GLM/DSA config keys found in CONFIG_MAPPING - patch target missing'; [open(f, 'w').write(txt) for k in matched for v in [CONFIG_MAPPING[k]] for f in [inspect.getfile(v)] for txt in [open(f).read().replace(\"'head_dim': 'qk_rope_head_dim',\", \"\").replace('\"head_dim\": \"qk_rope_head_dim\",', \"\").replace(\"'head_dim': 'qk_rope_head_dim'\", \"\").replace('\"head_dim\": \"qk_rope_head_dim\"', \"\")] if 'qk_rope_head_dim' in open(f).read()]; failed = [k for k in matched for v in [CONFIG_MAPPING[k]] if 'qk_rope_head_dim' in getattr(importlib.reload(inspect.getmodule(v)), v.__name__).attribute_map.values()]; assert not failed, f'qk_rope_head_dim still present in attribute_map for: {failed}'"
